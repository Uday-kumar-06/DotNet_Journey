@model IEnumerable<FinanceBilling.MVC.ViewModels.AuditLog.AuditLogViewModel>

@{
    ViewData["Title"] = "Audit Logs";
}

<h2>Audit Logs</h2>

<div class="card">

    <div class="card-body">

        <table id="auditTable"
               class="table table-bordered table-hover">

            <thead>

                <tr>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Date</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.Username</td>
                        <td>@log.Action</td>
                        <td>@log.EntityName</td>
                        <td>@log.Details</td>
                        <td>@log.ChangedAt</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts
{
    <script>
        $(document).ready(function () {
            $('#auditTable').DataTable();
        });
    </script>
}
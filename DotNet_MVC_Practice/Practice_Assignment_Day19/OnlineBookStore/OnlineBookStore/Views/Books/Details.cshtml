@model OnlineBookStore.Models.Book

<h2>Book Details</h2>

<div class="card p-3">

    <h3>@Model.Title</h3>

    <p>
        <strong>Author:</strong>
        @Model.Author
    </p>

    <p>
        <strong>ISBN:</strong>
        @Model.ISBN
    </p>

    <p>
        <strong>Price:</strong>
        ₹@Model.Price
    </p>

</div>

<a asp-controller="Books"
       asp-action="Index"
       class="btn btn-primary mt-3">
    Back
</a>
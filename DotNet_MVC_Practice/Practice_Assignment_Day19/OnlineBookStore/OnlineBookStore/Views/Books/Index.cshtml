@model IEnumerable<OnlineBookStore.Models.Book>

<h2>Book List</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Price</th>
            <th>Details</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.ISBN</td>
                <td>@book.Price</td>

                <td>
                    <a asp-controller="Books"
                           asp-action="Details"
                           asp-route-id="@book.Id">
                        View
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@page
@model AdvancedRazorPagesApp.Pages.Products.IndexModel

<h1>Product Management</h1>

<form method="post">

    <div>
        <label>Product Name</label>
        <input asp-for="NewProduct.Name" />
    </div>

    <br />

    <div>
        <label>Description</label>
        <textarea asp-for="NewProduct.Description"></textarea>
    </div>

    <br />

    <h3>Categories</h3>

    <div>
        <input asp-for="NewProduct.Categories[0].Name"
               placeholder="Category 1" />
    </div>

    <br />

    <div>
        <input asp-for="NewProduct.Categories[1].Name"
               placeholder="Category 2" />
    </div>

    <br />

    <button type="submit">Add Product</button>

</form>

<hr />

<h2>Product List</h2>

@foreach (var product in Model.Products)
{
    <partial name="_ProductSummary" model="product" />

    <a asp-page="/Products/Details"
           asp-route-id="@product.ProductID">
        View Details
    </a>

    <hr />
}
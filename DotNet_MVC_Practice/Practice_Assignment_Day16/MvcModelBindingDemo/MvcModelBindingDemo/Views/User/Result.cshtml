@model MvcModelBindingDemo.Models.User

@{
    ViewData["Title"] = "Submitted Data";
}

<h2>Submitted User Details</h2>

<h3>Basic Information</h3>

<p>
    <strong>First Name:</strong> @Model.FirstName
</p>

<p>
    <strong>Last Name:</strong> @Model.LastName
</p>

<p>
    <strong>Age:</strong> @Model.Age
</p>

<h3>Address Information</h3>

<p>
    <strong>Street:</strong> @Model.Address.Street
</p>

<p>
    <strong>City:</strong> @Model.Address.City
</p>

<p>
    <strong>Zip Code:</strong> @Model.Address.ZipCode
</p>
@page
@model RazorPagesAssignment.Pages.ItemsModel

<h2>Item List</h2>

<a asp-page="/AddItem">Add New Item</a>

<table border="1" cellpadding="10">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Price</th>
    </tr>

    @foreach (var item in Model.ItemList)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price</td>
        </tr>
    }
</table>
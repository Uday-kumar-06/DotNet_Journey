@page
@model RazorPagesAssignment.Pages.AddItemModel

<h2>Add Item</h2>

<form method="post">

    <div>
        <label>Item Name:</label>
        <input type="text" asp-for="NewItem.Name" />
    </div>

    <br />

    <div>
        <label>Price:</label>
        <input type="number" asp-for="NewItem.Price" />
    </div>

    <br />

    <button type="submit">Add Item</button>

</form>
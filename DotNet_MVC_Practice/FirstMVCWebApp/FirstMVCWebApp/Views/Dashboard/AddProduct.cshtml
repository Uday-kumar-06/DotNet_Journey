@using FirstMVCWebApp.Dto
@model ProductRequestDto
<div>@ViewBag.ErrorMessage</div>
<form class="w-50 mx-auto mt-5 p-4 border rounded shadow" asp-action="CreateProduct">

    <h2 class="text-center mb-4">Add Product</h2>

    <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input type="text" class="form-control" name="ProductName" asp-for="ProductName" placeholder="Enter product name">
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" asp-for="Description" rows="3" placeholder="Enter product description"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Price</label>
        <input type="number" class="form-control" name="Price" asp-for="Price" placeholder="Enter product price">
    </div>

    <div class="mb-3">
        <label class="form-label">Color</label>
        <input type="text" class="form-control" name="Color" asp-for="Color" placeholder="Enter product color">
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-success">
            Save Product
        </button>
    </div>

</form>
